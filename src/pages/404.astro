---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";

const title = "404 - 页面未找到 | 老牌机场";
const description = "抱歉，您访问的页面不存在或已被永久迁移。请通过下方核心导航回到老牌机场评测与专线导航。";
---

<Layout
  title={title}
  description={description}
  noindex={true}
>
  <Nav />

  <main class="max-w-3xl mx-auto pt-36 md:pt-44 pb-24 text-center px-4 text-[var(--white)]">
    <!-- 404 Error Hero -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#ef4444]/10 border border-[#ef4444]/30 text-[#ef4444] text-xs font-mono font-bold mb-6">
      <span class="size-2 rounded-full bg-[#ef4444] animate-ping"></span>
      ERROR 404 · PAGE NOT FOUND
    </div>

    <h1 class="text-6xl md:text-8xl font-black tracking-tight text-white mb-4">
      404
    </h1>

    <h2 class="text-xl md:text-2xl font-semibold text-[var(--white)] mb-4">
      您访问的页面已被迁移或链接失效
    </h2>

    <p class="text-sm text-[var(--white-icon)] max-w-md mx-auto leading-relaxed mb-10">
      老牌机场已全面升级 2026 最新专线架构与 42 家品牌数据矩阵。请从下方快速通道前往目标专栏：
    </p>

    <!-- Core Navigation Links -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-lg mx-auto mb-10 text-xs">
      <a
        href="/"
        class="p-3.5 rounded-xl bg-[#141416] border border-[#ffffff15] hover:border-[var(--sec)] hover:bg-[#1a1824] transition-all text-white font-medium"
      >
        🏠 返回网站首页
      </a>
      <a
        href="/brands/"
        class="p-3.5 rounded-xl bg-[#141416] border border-[#ffffff15] hover:border-[var(--sec)] hover:bg-[#1a1824] transition-all text-white font-medium"
      >
        📑 42家品牌库
      </a>
      <a
        href="/speedtest/"
        class="p-3.5 rounded-xl bg-[#141416] border border-[#ffffff15] hover:border-[var(--sec)] hover:bg-[#1a1824] transition-all text-white font-medium"
      >
        ⚡ 晚高峰测速图
      </a>
      <a
        href="/free/"
        class="p-3.5 rounded-xl bg-[#141416] border border-[#ffffff15] hover:border-[#A9FF5B] hover:bg-[#121f14] transition-all text-[#A9FF5B] font-medium"
      >
        🎁 免费资源专栏
      </a>
      <a
        href="/clients/"
        class="p-3.5 rounded-xl bg-[#141416] border border-[#ffffff15] hover:border-[var(--sec)] hover:bg-[#1a1824] transition-all text-white font-medium"
      >
        💻 客户端下载教程
      </a>
      <a
        href="/faq/"
        class="p-3.5 rounded-xl bg-[#141416] border border-[#ffffff15] hover:border-[var(--sec)] hover:bg-[#1a1824] transition-all text-white font-medium"
      >
        ❓ 机场百科 FAQ
      </a>
    </div>

    <div>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[var(--sec)] text-black font-semibold text-sm hover:opacity-90 transition-opacity"
      >
        ← 立即回到首页
      </a>
    </div>
  </main>

  <Footer />
</Layout>
