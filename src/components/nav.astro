---
interface NavItem {
  label: string;
  href: string;
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: "首页",
    href: "/",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"></path></svg>`,
  },
  {
    label: "42家品牌库",
    href: "/brands",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"></path></svg>`,
  },
  {
    label: "免费资源",
    href: "/free",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2L1 21H23L12 2ZM12 6L19.53 19H4.47L12 6ZM11 10V14H13V10H11ZM11 16V18H13V16H11Z"></path></svg>`,
  },
  {
    label: "机场FAQ",
    href: "/faq",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM13 19H11V17H13V19ZM15.07 11.25L14.17 12.17C13.45 12.9 13 13.5 13 15H11V14.5C11 13.4 11.45 12.4 12.17 11.67L13.41 10.41C13.78 10.05 14 9.55 14 9C14 7.9 13.1 7 12 7C10.9 7 10 7.9 10 9H8C8 6.79 9.79 5 12 5C14.21 5 16 6.79 16 9C16 9.88 15.64 10.68 15.07 11.25Z"></path></svg>`,
  },
  {
    label: "跑路预警",
    href: "/warnings",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M1 21H23L12 2L1 21ZM13 18H11V16H13V18ZM13 14H11V10H13V14Z"></path></svg>`,
  },
  {
    label: "晚高峰测速",
    href: "/speedtest",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20ZM12.5 7H11V13L16.2 16.2L17 14.9L12.5 12.2V7Z"></path></svg>`,
  },
  {
    label: "客户端下载",
    href: "/clients",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M13 10H18L12 16L6 10H11V3H13V10ZM4 19H20V21H4V19Z"></path></svg>`,
  },
];

const pathname = Astro.url.pathname;
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    class="fixed left-1/2 -translate-x-1/2 z-[100] bg-[var(--background)] border border-1 border-transparent backdrop-blur-xl transition-all duration-500 ease-in-out md:top-5 md:bottom-auto bottom-0 w-[96%] max-w-5xl"
  >
    <div class="container mx-auto flex justify-center items-center px-2 py-2">
      <ul
        class="flex w-full justify-between items-center md:space-x-1 md:justify-center md:gap-5 overflow-x-auto no-scrollbar"
      >
        {
          navItems.map((item) => {
            const isActive = item.href === "/" ? pathname === "/" : pathname.startsWith(item.href);
            return (
              <li class="flex-shrink-0">
                <a
                  href={item.href}
                  class={`flex flex-col md:flex-row items-center gap-1 md:gap-1.5 px-2 md:px-3 py-1 md:py-1.5 rounded-full transition-all text-xs md:text-sm font-medium relative group ${
                    isActive ? "text-white bg-[#ffffff10] border border-[var(--sec)]/40 active" : "text-[var(--white-icon)] hover:text-white hover:bg-[#ffffff08]"
                  }`}
                >
                  <span class="flex items-center justify-center">
                    <fragment set:html={item.icon} />
                  </span>
                  <span class="text-[11px] md:text-sm whitespace-nowrap">{item.label}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </nav>
</div>

<style>
  nav {
    transform: translateX(-50%);
    background-color: #101014f0;
    border: 1px solid #ffffff15;
    border-radius: 9999px;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.85);
  }

  nav.scrolling {
    background-color: #0b0b0ef8;
    border-color: #a476ff45;
    box-shadow: 0 12px 36px -8px rgba(164, 118, 255, 0.25);
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @media (max-width: 767px) {
    nav {
      width: 100% !important;
      max-width: 100% !important;
      transform: translateX(-50%);
      bottom: 0;
      left: 50%;
      position: fixed;
      border-radius: 1.25rem 1.25rem 0 0;
      border-color: #ffffff18;
      background-color: #0c0c0ffa;
      padding: 0.25rem 0.5rem;
    }

    body {
      padding-bottom: 70px;
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");

  function handleScroll() {
    if (window.scrollY > 20) {
      nav?.classList.add("scrolling");
    } else {
      nav?.classList.remove("scrolling");
    }
  }

  window.addEventListener("scroll", handleScroll, { passive: true });
</script>
