---
import LikeButton from "../React/LikeButton.tsx";

const currentYear = new Date().getFullYear();
---

<footer class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10">
      <!-- 互动与支持 -->
      <div class="flex flex-col lg:items-start items-center space-y-6">
        <div>
          <h4 class="text-lg font-medium text-[var(--white)] mb-2">机场老牌</h4>
          <p class="text-xs text-[var(--white-icon)] leading-relaxed max-w-xs">
            专注于高可用跨国网络拓扑实测、AI / 流媒体全解锁状态监控与极客客户端配置指南。
          </p>
        </div>

        <div class="flex space-x-4">
          <a
            href="mailto:contact@jichanglaopai.blog"
            class="flex items-center justify-center size-10 rounded-xl bg-[#141414] border border-[var(--white-icon-tr)] text-[var(--white-icon)] hover:text-white hover:border-[var(--sec)] transition-all"
            aria-label="Email"
            title="联系站长"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
          <a
            href="/brands"
            class="flex items-center justify-center size-10 rounded-xl bg-[#141414] border border-[var(--white-icon-tr)] text-[var(--white-icon)] hover:text-white hover:border-[var(--sec)] transition-all"
            aria-label="Brands"
            title="42家机场品牌库"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </a>
          <a
            href="/sitemap-index.xml"
            target="_blank"
            class="flex items-center justify-center size-10 rounded-xl bg-[#141414] border border-[var(--white-icon-tr)] text-[var(--white-icon)] hover:text-white hover:border-[var(--sec)] transition-all"
            aria-label="Sitemap"
            title="站点地图 Sitemap"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </a>
        </div>

        <LikeButton client:load />
      </div>

      <!-- 专题导航与内链矩阵 -->
      <div class="flex flex-col items-center lg:items-start space-y-3">
        <h4 class="text-sm font-semibold tracking-wider text-[var(--sec)] uppercase">
          专题导航矩阵
        </h4>
        <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs text-[var(--white-icon)]">
          <a href="/brands" class="hover:text-white transition-colors">• 42家品牌库</a>
          <a href="/free" class="hover:text-[#A9FF5B] transition-colors">• 免费资源专栏</a>
          <a href="/faq" class="hover:text-white transition-colors">• 机场百科 FAQ</a>
          <a href="/warnings" class="hover:text-[#ef4444] transition-colors">• 跑路预警雷达</a>
          <a href="/speedtest" class="hover:text-white transition-colors">• 晚高峰测速</a>
          <a href="/clients" class="hover:text-white transition-colors">• 客户端下载</a>
          <a href="/methodology" class="hover:text-[var(--sec)] transition-colors">• 评测方法论</a>
        </div>
        <div class="pt-2 text-[11px] text-[#71717a]">
          架构：Astro SSG · TailwindCSS · TypeScript
        </div>
      </div>

      <!-- 100% 独立节点健康看板（替代第三方跟踪 iframe） -->
      <div class="flex flex-col items-center lg:items-start space-y-4">
        <h4 class="text-sm font-semibold tracking-wider text-[var(--sec)] uppercase">
          节点网络健康监控
        </h4>
        <div class="w-full max-w-xs bg-[#141416] border border-[var(--white-icon-tr)] rounded-2xl p-4 space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-[#ffffff10]">
            <div class="flex items-center gap-2">
              <span class="size-2 rounded-full bg-[#22c55e] animate-ping"></span>
              <span class="text-xs font-medium text-white">全球专线拓扑正常</span>
            </div>
            <span class="text-[11px] font-mono text-[var(--sec)]">99.98% SLA</span>
          </div>

          <div class="space-y-2 text-xs">
            <div class="flex justify-between items-center text-[var(--white-icon)]">
              <span>🇭🇰 香港 BGP 专线</span>
              <span class="text-[#22c55e] font-mono">24ms · 极速</span>
            </div>
            <div class="flex justify-between items-center text-[var(--white-icon)]">
              <span>🇯🇵 日本 IPLC 专线</span>
              <span class="text-[#22c55e] font-mono">38ms · 稳定</span>
            </div>
            <div class="flex justify-between items-center text-[var(--white-icon)]">
              <span>🇸🇬 新加坡 Anycast</span>
              <span class="text-[#22c55e] font-mono">45ms · 极速</span>
            </div>
            <div class="flex justify-between items-center text-[var(--white-icon)]">
              <span>🇺🇸 美国住宅 AI 专线</span>
              <span class="text-[#22c55e] font-mono">118ms · 解锁</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 版权声明与原创标识 -->
    <div class="mt-12 pt-8 border-t border-[#ffffff10]">
      <p class="text-center text-xs text-[var(--white-icon)] space-y-2">
        <span class="block sm:inline"
          >Copyright © {currentYear} 机场老牌 (jichanglaopai.blog). 保留所有权利。</span
        >
        <span class="hidden sm:inline"> | </span>
        <span class="block sm:inline text-[#8a8a90]"
          >100% 独立资产托管 · 零外部追踪暗桩 · 专注客观评测与技术透明</span
        >
      </p>
    </div>
  </div>
</footer>
