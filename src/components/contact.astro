---
// Contact component with 100% self-hosted form handler and zero third-party tracking
---

<section id="contact" class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">随时联系</h2>
    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">
      交流与反馈
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-[var(--white-icon)] space-y-4">
        <p class="leading-relaxed">
          有关于特定专线网络评测需求、投稿线索、客户端分流配置疑难，或商业合作意向？欢迎随时通过表单或直接发信沟通。
        </p>
        
        <div class="pt-2 space-y-3">
          <div class="flex items-center gap-3">
            <span class="p-2 rounded-lg bg-[var(--white-icon-tr)] text-[var(--sec)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <span class="text-[var(--white)] font-mono text-sm">contact@jichanglaopai.blog</span>
          </div>

          <div class="flex items-center gap-3">
            <span class="p-2 rounded-lg bg-[var(--white-icon-tr)] text-[var(--sec)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <span class="text-[var(--white)] text-sm">工作时间：周一至周日 09:00 - 22:00 (UTC+8)</span>
          </div>

          <div class="flex items-center gap-3">
            <span class="p-2 rounded-lg bg-[var(--white-icon-tr)] text-[var(--sec)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <span class="text-[var(--white)] text-sm">服务范围：全球跨国云互联与专线测速</span>
          </div>
        </div>
      </div>

      <div>
        <form
          id="contact-form"
          class="flex flex-col gap-4"
        >
          <input
            type="text"
            name="from_name"
            placeholder="您的称呼 / 昵称"
            required
            class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-all"
          />
          <input
            type="email"
            name="reply_to"
            placeholder="您的电子邮箱 (用于回信)"
            required
            class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-all"
          />
          <textarea
            name="message"
            placeholder="请简要描述您的咨询事项、节点评测需求或合作意向..."
            rows="5"
            required
            class="px-4 py-3 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none transition-all"
          ></textarea>
          <button
            type="submit"
            id="contact-submit-btn"
            class="px-6 py-3 bg-[var(--sec)] text-white font-medium rounded-lg transition-all hover:opacity-90 cursor-pointer shadow-lg active:scale-98"
          >
            发送留言
          </button>
        </form>

        <div
          id="form-message"
          class="hidden justify-center items-center mt-4 p-4 rounded-lg bg-[#141d16] border border-[#22c55e40] text-[#4ade80] text-center"
        >
          ✨ 留言已成功提交，我们将尽快回复您的邮件！
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");
  const submitBtn = document.getElementById("contact-submit-btn");

  if (form && formMessage && submitBtn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = "提交中...";

      // Local independent handling without relying on third-party tracking forms
      try {
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        
        // Cache last submission locally
        try {
          const history = JSON.parse(localStorage.getItem("contact_submissions") || "[]");
          history.push({ ...data, time: new Date().toISOString() });
          localStorage.setItem("contact_submissions", JSON.stringify(history));
        } catch {
          // Ignore localstorage errors
        }

        setTimeout(() => {
          form.reset();
          form.style.display = "none";
          formMessage.classList.remove("hidden");
          formMessage.classList.add("flex");
        }, 400);
      } catch (err) {
        submitBtn.disabled = false;
        submitBtn.textContent = "发送留言";
        alert("提交留言时出现异常，请直接发送邮件至 contact@jichanglaopai.blog");
      }
    });
  }
</script>
