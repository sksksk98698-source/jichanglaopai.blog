---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:py-36 pb-14">
    <div class="text-left space-y-4">
      <div class="flex items-center gap-2">
        <span class="size-2 rounded-full bg-[#A9FF5B] animate-pulse"></span>
        <p class="text-xs md:text-sm text-[var(--white-icon)] tracking-wider uppercase font-semibold shiny-white">
          老牌机场 · 2026 跨国专线深度评测实验室
        </p>
      </div>

      <div
        class="flex flex-col lg:flex-row lg:items-center gap-6 lg:gap-10 pt-2"
      >
        <h1
          class="text-[var(--white)] text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight whitespace-nowrap shrink-0 leading-[1.15]"
        >
          老牌机场 <br />
          <span class="text-[var(--sec)] shiny-sec">评测与导航</span>
        </h1>
        <p class="text-base sm:text-lg md:text-xl lg:text-2xl text-[var(--white-icon)] leading-relaxed lg:border-l lg:border-[#ffffff15] lg:pl-8">
          客观实测 42 家主流机场，主推 <span class="text-white font-medium">光速云等核心专线</span>，提供晚高峰丢包与跑速实测切片，保障您的极致数字连接。
        </p>
      </div>

      <div class="flex flex-wrap justify-start gap-3 pt-3 md:pt-6">
        <a
          href="#projects"
          class="flex items-center gap-2 text-black bg-[var(--sec)] hover:opacity-95 transition duration-300 ease-in-out px-5 py-3 rounded-xl font-bold text-sm md:text-base shadow-lg shadow-[#a476ff]/20 active:scale-98"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          42 家品牌矩阵 (光速云居首)
        </a>
        <a
          href="/free"
          class="flex items-center gap-2 text-[#A9FF5B] hover:text-white transition duration-300 ease-in-out border border-[#A9FF5B]/30 hover:border-[#A9FF5B] px-4 py-3 rounded-xl bg-[#141416] font-medium text-sm md:text-base"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 1 21 23 21 12 2"/></svg>
          免费资源专栏
        </a>
        <a
          href="/faq"
          class="flex items-center gap-2 text-[var(--white)] hover:text-white transition duration-300 ease-in-out border border-[#ffffff15] hover:border-[var(--sec)] px-4 py-3 rounded-xl bg-[#141414] font-medium text-sm md:text-base"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          万字机场百科 FAQ
        </a>
        <a
          href="/warnings"
          class="flex items-center gap-2 text-[#ef4444] hover:text-white transition duration-300 ease-in-out border border-[#ef4444]/30 hover:border-[#ef4444] px-4 py-3 rounded-xl bg-[#141414] font-medium text-sm md:text-base"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          跑路预警雷达
        </a>
        <a
          href="/speedtest"
          class="flex items-center gap-2 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[#ffffff10] px-4 py-3 rounded-xl bg-[#121214] font-medium text-sm md:text-base"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          晚高峰测速
        </a>
      </div>
    </div>

    <LogoWall />

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList client:load />
      <div
        class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16"
      >
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
